            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/indicadores/variacion": {
      "get": {
        "tags": [
          "Indicadores"
        ],
        "summary": "Variación frente al año anterior y frente a 2019",
        "description": "Del último mes con dato (sin huecos desde enero) y del acumulado del año hasta ese mes, frente al mismo periodo del año anterior y de 2019. Si a la referencia le falta algún mes, la variación es `null`: no se compara contra un periodo incompleto.",
        "operationId": "ConsultarVariacion",
        "parameters": [
          {
            "name": "territorio",
            "in": "query",
            "description": "Un territorio con demanda. Por defecto, region-murcia.",
            "schema": {
              "type": "string"
