  "components": {
    "schemas": {
      "ComparacionPublica": {
        "required": [
          "valor_referencia",
          "variacion_pct"
        ],
        "type": "object",
        "properties": {
          "valor_referencia": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "variacion_pct": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "ControlPublico": {
        "required": [
          "control",
          "correcto",
          "detalle"
        ],
        "type": "object",
        "properties": {
          "control": {
            "type": "string"
          },
          "correcto": {
            "type": "boolean"
          },
          "detalle": {
            "type": "string"
          }
        }
      },
      "CuotaPublica": {
        "required": [
          "mes",
          "nombre_mes",
          "cuota_media",
          "indice"
        ],
        "type": "object",
        "properties": {
          "mes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "nombre_mes": {
            "type": "string"
          },
          "cuota_media": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "indice": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "DatosDeEstacionalidad": {
        "required": [
          "territorio",
          "tipo",
          "residencia",
          "medida",
          "perfil",
          "relacion_agosto_enero",
          "anios_usados"
        ],
        "type": "object",
        "properties": {
          "territorio": {
            "type": "string"
          },
          "tipo": {
            "type": "string"
          },
          "residencia": {
            "type": "string"
          },
          "medida": {
            "type": "string"
          },
          "perfil": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CuotaPublica"
            }
          },
          "relacion_agosto_enero": {
