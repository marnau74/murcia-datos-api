    "/v1/indicadores/estacionalidad": {
      "get": {
        "tags": [
          "Indicadores"
        ],
        "summary": "Perfil estacional y relación agosto/enero",
        "description": "Cada año completo (con los doce meses) reparte su total entre los meses; el perfil es la media de esas cuotas. `indice` vale 100 para un mes «medio». Los años con meses provisionales no entran salvo `incluir_provisionales=true`.",
        "operationId": "ConsultarEstacionalidad",
        "parameters": [
          {
            "name": "territorio",
            "in": "query",
            "description": "Un territorio con demanda. Por defecto, region-murcia.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tipo",
            "in": "query",
            "description": "Un tipo de alojamiento. Por defecto, hotel.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "medida",
            "in": "query",
            "description": "viajeros o pernoctaciones (por defecto).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "residencia",
            "in": "query",
            "description": "espana, extranjero o total (por defecto).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "anio",
            "in": "query",
            "description": "Solo en la variación: año a analizar. Por defecto, el último con datos.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "incluir_provisionales",
            "in": "query",
            "description": "Solo en la estacionalidad: true para que entren también los años con meses provisionales.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaDeEstacionalidad"
                }
              }
            }
          },
          "304": {
            "description": "Not Modified"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
