# Copia este fichero a «.env» y rellénalo. Nada de aquí es un secreto: la API no tiene claves ni base de datos.

# Tu usuario u organización de GitHub, en minúsculas (de ahí sale la imagen: ghcr.io/<PROPIETARIO>/murcia-datos-api).
PROPIETARIO=marnau74

# Dominio de la web. Sin dominio propio: la IP del servidor con guiones + .sslip.io (203.0.113.7 → 203-0-113-7.sslip.io).
DOMINIO=203-0-113-7.sslip.io

# Versión de la imagen: «latest» o una etiqueta (por ejemplo 1.0.0).
VERSION=latest

# Peticiones que una misma IP puede hacer por minuto.
LIMITE_PETICIONES=120

# Repositorio de GitHub del que se descargan las releases de datos (datos-AAAA-MM).
REPOSITORIO_DE_DATOS=marnau74/murcia-open-data
